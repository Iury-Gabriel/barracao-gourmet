# Exemplo de variaveis de ambiente do backend (copie para .env e ajuste para cada ambiente). Teste de auto-deploy.
PORT=3333
DATABASE_URL="postgresql://usuario:senha@localhost:5432/barracao_gourmet?schema=public"
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="7d"
NODE_ENV=development
PUBLIC_BASE_URL="http://localhost:18086"
CORS_ORIGINS="http://localhost:18086,http://localhost:8080,http://localhost:5173,http://localhost:3000"
REDIS_URL="redis://localhost:16379"
WEBHOOK_DEBOUNCE_SECONDS=10
WEBHOOK_DEBOUNCE_POLL_MS=1000
MERCADO_PAGO_API_BASE_URL="https://api.mercadopago.com"
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PIX_EXPIRATION_MINUTES=30
MERCADO_PAGO_WEBHOOK_SECRET=""
# Endereco da loja: origem de TODO calculo de frete/distancia do delivery.
# Preencha com o endereco real do Barracao Gourmet (lat/lon: pegue no Google Maps).
LOJA_ENDERECO_BASE="Rua Exemplo, 100, Bairro, Cidade, UF, Brasil"
LOJA_ENDERECO_RETIRADA="Rua Exemplo, 100"
LOJA_LAT=-23.6798252
LOJA_LON=-46.6776943
# OpenRouteService: opcional. Ja existe um valor padrao embutido em src/config/env.ts.
OPENROUTESERVICE_API_KEY=""
OPENROUTESERVICE_BASE_URL="https://api.openrouteservice.org"
# AwesomeAPI (CEP -> coordenadas). Chave enviada no header x-api-key. Registre em https://awesomeapi.com.br
AWESOMEAPI_API_KEY=""
# Pushover: notificacoes push de erros criticos (IA, frete, pagamento, webhook). https://pushover.net/apps/build
PUSHOVER_TOKEN=""
PUSHOVER_USER=""
